# Visitor alerts on Telegram. Copy to .env for scripts/telegram-setup.mjs; the live site reads the same
# names from Vercel → Project → Settings → Environment Variables. With the token or chat id unset, the
# alerts are a quiet no-op. Setup: docs/BEACON.md
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Any long random string (letters, digits, _ or -). Lets the bot take commands like /bots off.
# Make one: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=
# Optional: crawler alerts before you've used /bots: 1 = all (default), ai = AI agents only, 0 = humans only.
# BEACON_ALERT_BOTS=1
